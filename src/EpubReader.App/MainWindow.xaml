<Window x:Class="EpubReader.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EpubReader"
        Height="900" Width="1200"
        MinHeight="480" MinWidth="640"
        Background="#FFFFFFFF"
        Foreground="#FF1A1612"
        FontFamily="Microsoft JhengHei UI, Yu Gothic UI, Microsoft YaHei UI, Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        AllowDrop="True"
        Drop="OnDrop"
        DragOver="OnDragOver"
        PreviewKeyDown="OnPreviewKeyDown"
        PreviewMouseWheel="OnWheel"
        SizeChanged="OnSizeChanged"
        Closing="OnClosing"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
        <Image x:Name="PageImage"
               Stretch="Fill"
               RenderOptions.BitmapScalingMode="HighQuality"
               MouseLeftButtonDown="OnPageClick"/>
        <TextBlock x:Name="EmptyHint"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   FontSize="20"
                   Opacity="0.45"
                   TextAlignment="Center"
                   Text="將 EPUB / CBZ 拖進來&#x0a;或按 O 開檔"/>

        <Border x:Name="TocPanel"
                Width="360"
                HorizontalAlignment="Left"
                Background="#F2FFFFF8"
                Visibility="Collapsed"
                Panel.ZIndex="15">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Margin="16,48,16,10" FontSize="20" FontWeight="SemiBold" Text="目次"/>
                <ListBox x:Name="TocList"
                         Background="Transparent"
                         BorderThickness="0"
                         FontSize="18"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.CanContentScroll="False"
                         MouseDoubleClick="OnTocClick"
                         KeyDown="OnTocKey">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Title}"
                                       FontSize="18"
                                       TextWrapping="Wrap"
                                       LineHeight="26"
                                       Padding="2,6"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <Border x:Name="IllustPanel"
                Background="#F2FFFFF8"
                Visibility="Collapsed"
                Panel.ZIndex="15">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="20,48,20,8">
                    <TextBlock FontSize="18" Text="插圖" VerticalAlignment="Center"/>
                    <TextBlock x:Name="IllustCount" Margin="12,0,0,0" Opacity="0.7" VerticalAlignment="Center"/>
                    <TextBlock HorizontalAlignment="Right" Opacity="0.55" VerticalAlignment="Center"
                               Text="點選放大　連點前往正文　Esc 返回"/>
                </DockPanel>
                <Grid>
                    <TextBlock x:Name="IllustEmpty"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontSize="16" Opacity="0.55" Visibility="Collapsed"
                               Text="這本書沒有達到門檻的插圖"/>
                    <ScrollViewer x:Name="IllustScroll" VerticalScrollBarVisibility="Auto" Padding="12,4,12,16">
                        <WrapPanel x:Name="IllustWrap" ItemWidth="176" ItemHeight="236"/>
                    </ScrollViewer>
                </Grid>
            </DockPanel>
        </Border>

        <Border x:Name="Toolbar"
                VerticalAlignment="Top"
                Height="56"
                Panel.ZIndex="20"
                Background="#E6FFFFF8"
                BorderBrush="#33808080"
                BorderThickness="0,0,0,1"
                Visibility="Collapsed">
            <DockPanel Margin="8,0">
                <Button Content="目錄" Click="OnToggleToc" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                <Button Content="開檔" Click="OnOpen" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                <TextBlock x:Name="StatusText"
                           DockPanel.Dock="Right"
                           VerticalAlignment="Center"
                           Margin="12,0"
                           Opacity="0.7"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnVertical" Content="直排" Click="OnToggleVertical"/>
                    <Button x:Name="BtnSpread" Content="雙頁" Click="OnToggleSpread"/>
                    <Button Content="插圖" Click="OnToggleIllust"/>
                    <Button Content="A−" Click="OnFontDown"/>
                    <Button Content="A+" Click="OnFontUp"/>
                    <Button x:Name="BtnTheme" Content="預設" Click="OnTheme"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border x:Name="SideBar"
                HorizontalAlignment="Right"
                Width="48"
                Background="Transparent"
                Visibility="Collapsed"
                Panel.ZIndex="12"
                Padding="8,0,12,0">
            <Slider x:Name="SideSlider"
                    Style="{StaticResource AeroSeekSlider}"
                    Orientation="Vertical"
                    Minimum="0" Maximum="1" Value="0"
                    IsDirectionReversed="True"
                    Width="22"
                    HorizontalAlignment="Center"
                    ValueChanged="OnSliderChanged"
                    PreviewMouseLeftButtonDown="OnSliderPreviewDown"
                    PreviewMouseLeftButtonUp="OnSliderPreviewUp"
                    PreviewMouseMove="OnSliderPreviewMove"
                    LostMouseCapture="OnSliderLostCapture"/>
        </Border>
        </Grid>

        <Border x:Name="BottomBar"
                Grid.Row="1"
                Height="48"
                Background="Transparent"
                Panel.ZIndex="12"
                Padding="0,12,0,8">
            <Slider x:Name="ProgressSlider"
                    Style="{StaticResource AeroSeekSlider}"
                    Minimum="0" Maximum="1" Value="0"
                    IsDirectionReversed="True"
                    Height="22"
                    VerticalAlignment="Center"
                    ValueChanged="OnSliderChanged"
                    PreviewMouseLeftButtonDown="OnSliderPreviewDown"
                    PreviewMouseLeftButtonUp="OnSliderPreviewUp"
                    PreviewMouseMove="OnSliderPreviewMove"
                    LostMouseCapture="OnSliderLostCapture"/>
        </Border>

        <Grid x:Name="ImageViewer"
              Grid.Row="0" Grid.RowSpan="2"
              Background="#F2000000"
              Visibility="Collapsed"
              Panel.ZIndex="30"
              MouseLeftButtonDown="OnViewerClick">
            <Image x:Name="ViewerImage"
                   Stretch="Uniform"
                   Margin="0,0,0,52"
                   MouseLeftButtonDown="OnViewerImageDown"/>
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Margin="0,0,0,12">
                <TextBlock Opacity="0.7" VerticalAlignment="Center" Foreground="White" Text="← → 鄰近"/>
                <Button Content="前往此頁" Click="OnJumpViewer" Margin="18,0,0,0"/>
                <TextBlock Opacity="0.55" VerticalAlignment="Center" Margin="18,0,0,0" Foreground="White" Text="Esc 返回相冊"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
